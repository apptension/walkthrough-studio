{
  "title": "__TITLE__",
  "audience": "Who watches this and what they should be able to do afterwards",
  "purpose": "overview",
  "brand": "admiral",
  "open": {
    "eyebrow": "Product walkthrough",
    "title": [
      "First line of the promise",
      "second line with an *accent*"
    ],
    "sub": "*Outcome one* \u00b7 outcome two \u00b7 outcome three"
  },
  "close": {
    "title": [
      "Short recap line.",
      "The payoff, *accented.*"
    ],
    "steps": [
      {
        "label": "First step",
        "note": "What the viewer did, in plain words"
      },
      {
        "label": "Second step",
        "note": "Keep each note under ~40 characters"
      },
      {
        "label": "Third step",
        "note": "End on the business outcome"
      }
    ]
  },
  "chapterLabels": {
    "start": "Getting started"
  },
  "record": {
    "startUrl": "http://localhost:3000/en/auth/login",
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "slowMo": 35
  },
  "env": {
    "baseUrl": "http://localhost:3000",
    "mailUrl": "http://localhost:1080",
    "staffEmail": "$WALKTHROUGH_STAFF_EMAIL",
    "staffPassword": "$WALKTHROUGH_STAFF_PASSWORD"
  },
  "direction": {
    "look": "studio",
    "pace": "steady",
    "camera": {
      "zoom": "subtle",
      "frame": "inset",
      "background": "brand",
      "padding": "balanced",
      "corners": "soft",
      "shadow": "soft"
    },
    "cursor": {
      "style": "arrow",
      "size": "m",
      "glide": true,
      "hideIdle": true,
      "loop": false
    },
    "keys": true,
    "motion": {
      "atmosphere": "aurora",
      "titleReveal": "rise",
      "depth": "soft",
      "sheen": true
    },
    "overlays": {
      "preset": "plateMatch",
      "caption": {
        "seat": "bottom-center",
        "maxWidth": 560,
        "bottom": 40,
        "align": "left"
      }
    }
  }
}
