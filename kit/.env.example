# Copy to kit/.env (gitignored). Shell variables take precedence over this file.

# ElevenLabs — narration (Eleven v4) and music bed (Eleven Music). Pay-as-you-go or Creator+
# key; the plan must carry commercial rights for client-facing videos.
ELEVENLABS_API_KEY=

# Optional: Cursor CLI auth for Studio "Improve" jobs (alternative to `agent login`).
# CURSOR_API_KEY=
# Optional: Claude Code auth (alternative to `claude` /login).
# ANTHROPIC_API_KEY=
# Which agent runs Studio jobs: cursor | claude. Unset = signed-in Cursor CLI, else Claude Code.
# Studio header switch writes this when both CLIs are installed.
# Both stream into the same live feed (lib/agentStream.mjs → studio/agentStream.js).
# WALKTHROUGH_AGENT=

# Set to 1 to run voice/music/mix without credits (macOS `say` + synthesized pad). Never deliver.
# WALKTHROUGH_AUDIO_STUB=1

# Per-video demo accounts (referenced from video.config.json as $VAR — never hard-code secrets).
# EXAMPLE_EMAIL=
# EXAMPLE_PASSWORD=
