# Dependencies
node_modules/
kit/node_modules/

# Secrets & local env
.env
.env.*
!.env.example
kit/.env
kit/.env.*
!kit/.env.example

# Generated renders, captures, deliverables (can be tens of GB)
tmp/
kit/tmp/
**/tmp/videos/

# Media artifacts (regenerate via the pipeline)
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.m4a
*.aac
*.flac

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# Logs & caches
*.log
npm-debug.log*
.cache/
.turbo/
coverage/
.nyc_output/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Local probes / scratch (not part of the product)
kit/tmp-*.mjs
kit/*-probe*.mjs
.write-test

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local agent design/plan scratch — never ship
docs/superpowers/

# Local productions. Only the Studio walkthrough ships with the product.
# Any project you add under videos/ or kit/brands/ stays untracked.
videos/*
!videos/walkthrough-studio/
!videos/walkthrough-studio/**
kit/brands/*
!kit/brands/acme/
!kit/brands/acme/**
!kit/brands/admiral/
!kit/brands/admiral/**
!kit/brands/apptension-walkthrough-studio/
!kit/brands/apptension-walkthrough-studio/**
